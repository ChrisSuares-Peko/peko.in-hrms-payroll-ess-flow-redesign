    "paytmchecksum": "^1.5.1",
    "puppeteer": "^25.7.0",
    "pusher": "^5.2.0",
    "qrcode": "^1.5.4",
    "razorpay": "^2.9.2",
    "redis": "^5.12.1",
    "sequelize": "^6.37.3",
    "uuid": "^11.1.1",
    "winston": "^3.13.0",
    "winston-elasticsearch": "^0.11.0",
    "winston-loki": "^6.1.2",
    "wkhtmltopdf": "^0.4.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^30.5.2",
    "sequelize-cli": "^6.6.3"
  },
  "overrides": {
    "undici": "^6.29.0",
    "minimatch": ">=10.2.3",
