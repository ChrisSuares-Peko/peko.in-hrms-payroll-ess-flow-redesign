    "@google-cloud/pubsub": "^4.9.0",
    "@logtail/node": "^0.5.0",
    "@logtail/winston": "^0.5.0",
    "@sendgrid/mail": "^8.1.6",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.1",
    "bull": "^4.11.4",
    "cashfree-sdk": "^0.1.1",
    "compression": "^1.7.2",
    "connect-flash": "^0.1.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "crypto-js": "^4.1.1",
    "debug": "^2.6.9",
    "dotenv": "^6.2.0",
    "elastic-apm-node": "^4.10.0",
    "email-templates": "^13.0.0",
    "express": "^4.21.2",
    "express-fileupload": "^1.4.0",
    "express-minify": "^1.0.0",
    "express-session": "^1.17.3",
    "express-useragent": "^1.0.15",
    "fast-xml-parser": "^5.3.4",
    "firebase": "^11.3.1",
    "firebase-admin": "^14.5.0",
    "helmet": "^3.12.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "jssha": "^3.3.1",
    "libsodium-wrappers": "^0.8.4",
    "moment": "^2.19.1",
    "mysql2": "^3.11.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^10.0.13",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
