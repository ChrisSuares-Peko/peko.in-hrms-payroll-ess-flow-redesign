# Use an official Node.js runtime as a base image
FROM node:24

# Set the environment variable for the time zone
ENV TZ=Asia/Kolkata

# Set the working directory in the container
WORKDIR /usr/src/app

# 2. Consolidate system dependencies and clean up in ONE layer
RUN apt-get update && apt-get install -y \
    tzdata \
    ca-certificates \
    fonts-liberation \
    libasound2 \
    libatk1.0-0 \
    libc6 \
    libcairo2 \
    libcups2 \
    libdbus-1-3 \
    libexpat1 \
    libfontconfig1 \
    libgbm1 \
    libgcc1 \
    libgconf-2-4 \
    libgdk-pixbuf2.0-0 \
    libglib2.0-0 \
    libgtk-3-0 \
    libnspr4 \
    libnss3 \
    libpango-1.0-0 \
    libpangocairo-1.0-0 \
    libstdc++6 \
    libx11-6 \
    libx11-xcb1 \
    libxcb1 \
    libxcomposite1 \
    libxcursor1 \
    libxdamage1 \
    libxext6 \
    libxfixes3 \
    libxi6 \
    libxrandr2 \
    libxrender1 \
    libxss1 \
    libxtst6 \
    lsb-release \
    xdg-utils \
    wget \
    # Set Timezone (Note: Ensure ENV TZ is defined above this line)
    && ln -snf /usr/share/zoneinfo/$TZ /etc/localtime && echo $TZ > /etc/timezone \
    # Clean up cache to reduce final image size significantly
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# 3. Install Node dependencies using caching
COPY package*.json ./
# Combining npm ci to avoid multiple layers
# RUN npm install && npm install puppeteer
RUN npm ci && \
    npx puppeteer browsers install chrome

# Bundle app source
COPY . .

# Expose the port the 4445 app runs on
EXPOSE 4442

# Define the command to run your app
CMD ["sh", "-c", "npm run migrate && npm run start:prod"]