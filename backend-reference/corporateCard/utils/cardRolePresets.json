                        "permissions": [
                            { "key": "corporate_cards.view-wallet", "label": "View wallet & balances" },
                            { "key": "corporate_cards.topup-wallet", "label": "Top up wallet" }
                        ]
                    },
                    {
                        "category": "Account",
                        "permissions": [
                            { "key": "corporate_cards.view-statement", "label": "View account statement" },
                            { "key": "corporate_cards.export-statement", "label": "Export account statement" },
