                    },
                    {
                        "category": "Accounting",
                        "permissions": [
                            { "key": "corporate_cards.view-accounting", "label": "View accounting report" },
                            { "key": "corporate_cards.export-accounting", "label": "Map & export to accounting software" }
                        ]
                    },
                    {
                        "category": "Settings",
                        "permissions": [
                            { "key": "corporate_cards.view-roles", "label": "View roles & permissions" }
                        ]
                    },
                    {
                        "category": "Audit",
                        "permissions": [
                            { "key": "corporate_cards.view-audit", "label": "View audit logs (read-only)" }
                        ]
                    }
