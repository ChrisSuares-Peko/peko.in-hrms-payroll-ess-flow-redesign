    "catalogue": {
        "services": [
            {
                "service": "Corporate Cards",
                "accessKey": "corporate_cards",
                "categories": [
                    {
                        "category": "Self-service",
                        "permissions": [
                            { "key": "corporate_cards.view-own-cards", "label": "View their own cards" },
                            { "key": "corporate_cards.request-card", "label": "Request a new card" },
                            { "key": "corporate_cards.request-limit-increase", "label": "Request a limit increase" },
                            { "key": "corporate_cards.freeze-own-card", "label": "Freeze / unfreeze their own card" },
                            { "key": "corporate_cards.request-unfreeze", "label": "Request an unfreeze after an admin freeze" },
                            { "key": "corporate_cards.view-own-transactions", "label": "View & export their own transactions" },
                            { "key": "corporate_cards.upload-own-receipts", "label": "Add receipts & comments on their own transactions" },
                            { "key": "corporate_cards.complete-own-kyc", "label": "Complete their own KYC" }
                        ]
                    },
                    {
                        "category": "General",
                        "permissions": [
                            { "key": "corporate_cards.view-dashboard", "label": "View company dashboard" }
                        ]
                    },
