                "corporate_cards.view-dashboard",
                "corporate_cards.view-members",
                "corporate_cards.invite-members",
                "corporate_cards.remove-members",
                "corporate_cards.assign-roles",
                "corporate_cards.create-teams",
                "corporate_cards.view-cards",
                "corporate_cards.issue-cards",
                "corporate_cards.order-physical-cards",
                "corporate_cards.freeze-cards",
                "corporate_cards.set-limits",
                "corporate_cards.terminate-cards",
                "corporate_cards.view-transactions",
                "corporate_cards.export-transactions",
                "corporate_cards.manage-receipts",
                "corporate_cards.approve-card-req",
                "corporate_cards.approve-limit-increase",
                "corporate_cards.approve-unfreeze",
                "corporate_cards.approve-txn",
                "corporate_cards.approve-reimb",
                "corporate_cards.approve-vendor",
                "corporate_cards.approve-topup",
                "corporate_cards.view-wallet",
                "corporate_cards.topup-wallet",
                "corporate_cards.view-statement",
                "corporate_cards.export-statement",
                "corporate_cards.record-entries",
                "corporate_cards.view-accounting",
                "corporate_cards.export-accounting",
                "corporate_cards.view-roles",
                "corporate_cards.view-audit"
            ]
        },
        {
            "roleName": "Employee",
            "description": "Self-service only: their own card, transactions, receipts and requests.",
            "actsAsCorporateAdmin": false,
            "permissions": [
                "corporate_cards.view-own-cards",
                "corporate_cards.request-card",
                "corporate_cards.request-limit-increase",
                "corporate_cards.freeze-own-card",
                "corporate_cards.request-unfreeze",
                "corporate_cards.view-own-transactions",
                "corporate_cards.upload-own-receipts",
                "corporate_cards.complete-own-kyc"
            ]
        }
