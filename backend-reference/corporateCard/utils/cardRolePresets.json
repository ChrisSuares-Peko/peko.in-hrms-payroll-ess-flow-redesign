                            { "key": "corporate_cards.view-cards", "label": "View all cards" },
                            { "key": "corporate_cards.issue-cards", "label": "Issue new cards" },
                            { "key": "corporate_cards.order-physical-cards", "label": "Order physical cards" },
                            { "key": "corporate_cards.freeze-cards", "label": "Freeze / unfreeze any card" },
                            { "key": "corporate_cards.set-limits", "label": "Set card spend limits & controls" },
                            { "key": "corporate_cards.terminate-cards", "label": "Terminate cards" }
