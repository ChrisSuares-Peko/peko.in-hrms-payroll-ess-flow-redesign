                    },
                    {
                        "category": "Approvals",
                        "permissions": [
                            { "key": "corporate_cards.approve-card-req", "label": "Approve card issuance requests" },
                            { "key": "corporate_cards.approve-limit-increase", "label": "Approve limit increase requests" },
                            { "key": "corporate_cards.approve-unfreeze", "label": "Approve card unfreeze requests" },
                            { "key": "corporate_cards.approve-txn", "label": "Approve card transactions" },
                            { "key": "corporate_cards.approve-reimb", "label": "Approve reimbursements" },
                            { "key": "corporate_cards.approve-vendor", "label": "Approve vendor invoices" },
                            { "key": "corporate_cards.approve-topup", "label": "Approve card top-up requests" }
