{
  "name": "peko",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "npm run migrate:local && dotenvx run -f .env.local -- nodemon ./bin/www",
    "start:prod": "dotenvx run -f .env.${NODE_ENV} -- node ./bin/www",
    "lint": "eslint .",
    "test": "jest --detectOpenHandles",
    "migrate": "dotenvx run -f .env.${NODE_ENV} -- sequelize-cli db:migrate",
    "migrate:local": "dotenvx run -f .env.local -- sequelize-cli db:migrate"
  },
  "dependencies": {
    "@aws-sdk/client-kms": "^3.650.0",
    "@aws-sdk/client-s3": "^3.651.0",
    "@dotenvx/dotenvx": "^2.14.0",
    "@elastic/elasticsearch": "^8.15.0",
    "@logtail/node": "^0.5.0",
    "@logtail/winston": "^0.5.0",
    "@sendgrid/mail": "^8.1.6",
    "async": "^2.6.4",
    "axios": "^1.20.0",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "compression": "^1.7.5",
    "connect-flash": "^0.1.1",
    "connect-redis": "^7.1.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "debug": "^4.3.4",
    "dotenv": "^6.2.0",
    "email-templates": "^13.0.1",
    "exceljs": "^4.4.0",
    "express": "^4.21.2",
    "express-session": "^1.18.1",
    "express-useragent": "^1.0.15",
    "firebase": "^11.3.1",
    "firebase-admin": "^13.10.0",
    "helmet": "^3.12.1",
    "joi": "^17.13.3",
    "jsonwebtoken": "^9.0.2",
    "libsodium-wrappers": "^0.7.15",
    "moment": "^2.19.1",
    "moment-timezone": "^0.5.45",
    "mongoose": "^8.8.3",
    "mysql2": "^3.11.0",
    "node-schedule": "^2.1.1",
    "nodemailer": "^10.0.12",
    "passport": "^0.7.0",
    "puppeteer": "^25.7.0",
    "pusher": "^5.2.0",
    "redis": "^5.12.1",
    "sequelize": "^6.37.5",
    "uuid": "^11.1.1",
    "winston": "^3.14.2",
    "winston-elasticsearch": "^0.19.0",
    "winston-loki": "^6.1.2",
    "wkhtmltopdf": "^0.4.0"
  },
  "devDependencies": {
    "eslint": "^8.56.0",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jest": "^28.11.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.4",
    "sequelize-cli": "^6.6.3"
  },
  "overrides": {
    "undici": "^6.29.0",
    "linkify-it": "^5.0.2",
    "cookie": "0.7.2",
    "glob": "^10.2.2",
    "fast-xml-parser": ">=5.3.4",
    "@tootallnate/once": ">=3.0.1",
    "minimatch": ">=10.2.3",
    "brace-expansion": "^5.0.12",
    "form-data": ">=4.0.4",
    "nodemailer": "^10.0.12",
    "@grpc/grpc-js": "^1.14.5",
    "axios": "^1.20.0",
    "uuid": "^11.1.1",
    "@opentelemetry/core": "^2.8.0",
    "chokidar": "^4.0.3"
  },
  "jest": {
    "testEnvironment": "node",
    "moduleNameMapper": {
      "^puppeteer$": "<rootDir>/tests/stubs/puppeteer.js"
    },
    "setupFilesAfterEnv": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/routes/",
      "models/use-cases/payroll/"
    ]
  }
